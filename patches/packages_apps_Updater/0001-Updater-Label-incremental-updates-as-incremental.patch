@@ -55,6 +55,7 @@ class UpdatesRepository(
 
         val networkUpdates = withContext(Dispatchers.IO) {
             networkDataSource.fetchUpdates().map { it.toUpdate() }.filter { filterUpdates(it) }
+                .let { preferIncremental(it) }
         }
 
         if (networkUpdates.isEmpty()) return System.currentTimeMillis()
@@ -91,7 +92,23 @@ class UpdatesRepository(
         return System.currentTimeMillis()
     }
 
+    // One feed serves every build: it lists the full OTA plus incrementals from
+    // several older builds. Where an incremental applies to the running build,
+    // offer it instead of the full OTA of the same build.
+    private fun preferIncremental(updates: List<Update>): List<Update> {
+        val incrementalBuilds = updates.filter { it.isIncremental }.map { it.timestamp }.toSet()
+        return updates.filter { it.isIncremental || it.timestamp !in incrementalBuilds }
+    }
+
     private fun filterUpdates(update: Update): Boolean {
+        // An incremental only applies over the build it was made from.
+        if (update.isIncremental &&
+            update.preBuildIncremental != DeviceInfoUtils.buildVersionIncremental
+        ) {
+            Log.d(TAG, "${update.name} is an incremental for build ${update.preBuildIncremental}")
+            return false
+        }
+
         val isCurrentBuild = update.timestamp == DeviceInfoUtils.buildDateTimestamp
         val isOlderBuild = update.timestamp < DeviceInfoUtils.buildDateTimestamp
 
