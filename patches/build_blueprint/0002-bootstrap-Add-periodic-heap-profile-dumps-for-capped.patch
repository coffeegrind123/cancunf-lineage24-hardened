From 1df4c63d68beb8dfe05b0101826ff777f5701715 Mon Sep 17 00:00:00 2001
From: lineage-build <build@localhost>
Date: Wed, 11 Nov 2026 05:39:22 +0000
Subject: [PATCH] bootstrap: Add periodic heap profile dumps for capped
 hosts

--memprofile only writes when analysis finishes. With
SOONG_PERIODIC_MEMPROFILE=<dir> set, dump the in-use heap as text every
15 s, so a run that dies at a memory cap still shows what held the heap.

Change-Id: I9809136201493782a73a0158ac1af4af004d1967
---
 bootstrap/command.go | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/bootstrap/command.go b/bootstrap/command.go
index e5f6862..d9be9de 100644
--- a/bootstrap/command.go
+++ b/bootstrap/command.go
@@ -25,6 +25,7 @@ import (
 	"runtime/pprof"
 	"runtime/trace"
 	"strings"
+	"time"
 
 	"github.com/google/blueprint"
 	"github.com/google/blueprint/proptools"
@@ -70,6 +71,25 @@ var goModuleTypesAreWrapped = false
 func RunBlueprint(args Args, stopBefore StopBefore, ctx *blueprint.Context, config interface{}) ([]string, error) {
 	runtime.GOMAXPROCS(runtime.NumCPU())
 
+	// Debugging aid for memory-capped hosts: the --memprofile heap profile is
+	// only written when analysis finishes, which an out-of-memory run never
+	// does. Dump the in-use heap as text every 15 s into this directory.
+	if dir := os.Getenv("SOONG_PERIODIC_MEMPROFILE"); dir != "" {
+		// soong_build turns sampling off unless --memprofile is given.
+		if runtime.MemProfileRate == 0 {
+			runtime.MemProfileRate = 512 * 1024
+		}
+		go func() {
+			for i := 0; ; i++ {
+				time.Sleep(15 * time.Second)
+				if f, err := os.Create(fmt.Sprintf("%s/heap-%d-%04d.txt", dir, os.Getpid(), i)); err == nil {
+					pprof.Lookup("heap").WriteTo(f, 1)
+					f.Close()
+				}
+			}
+		}()
+	}
+
 	if args.NoGC {
 		debug.SetGCPercent(-1)
 	}
-- 
2.43.0

