         if (packageId != UNKNOWN) {
-            Slog.d(TAG, "set packageId of " +  pkg.getPackageName() + " to " + packageId);
+            Slog.d(TAG, "set packageId of " + packageName + " to " + packageId);
         }
 
         var ext = new PackageExt(packageId, getExtFlags());
