From fe341a80dce5b6ec02536c86036d8ddb4ed12aa5 Mon Sep 17 00:00:00 2001
From: Dmitry Muhomor <muhomor.dmitry@gmail.com>
Date: Wed, 3 Jan 2024 15:26:50 +0200
Subject: [PATCH 05/67] define package name of first-party app source

(cherry picked from commit 927469654d1c151d5207fa6512213f7e515d0e53)
---
 core/java/android/util/PackageUtils.java | 4 ++++
 core/res/res/values/config_ext.xml       | 2 ++
 core/res/res/values/public-ext.xml       | 2 ++
 3 files changed, 8 insertions(+)

diff --git a/core/java/android/util/PackageUtils.java b/core/java/android/util/PackageUtils.java
index 533d341bd2..6dc86a0c76 100644
--- a/core/java/android/util/PackageUtils.java
+++ b/core/java/android/util/PackageUtils.java
@@ -280,4 +280,8 @@ public final class PackageUtils {
         }
         return list;
     }
+
+    public static String getFirstPartyAppSourcePackageName(Context ctx) {
+        return ctx.getString(com.android.internal.R.string.config_first_party_app_source_package_name);
+    }
 }
diff --git a/core/res/res/values/config_ext.xml b/core/res/res/values/config_ext.xml
index 045e125f3d..5e0b997d62 100644
--- a/core/res/res/values/config_ext.xml
+++ b/core/res/res/values/config_ext.xml
@@ -1,3 +1,5 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
+    <string name="config_first_party_app_source_package_name">app.grapheneos.apps</string>
+    <java-symbol type="string" name="config_first_party_app_source_package_name" />
 </resources>
diff --git a/core/res/res/values/public-ext.xml b/core/res/res/values/public-ext.xml
index 06f313da7d..eefc949c3d 100644
--- a/core/res/res/values/public-ext.xml
+++ b/core/res/res/values/public-ext.xml
@@ -13,5 +13,7 @@
     </staging-public-group>
 
     <staging-public-group type="string" first-id="0x0198f000">
+        <!-- @hide -->
+        <public name="config_first_party_app_source_package_name"/>
     </staging-public-group>
 </resources>
