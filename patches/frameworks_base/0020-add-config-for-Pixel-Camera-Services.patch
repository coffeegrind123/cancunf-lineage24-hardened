Subject: [PATCH 20/67] add config for Pixel Camera Services

(cherry picked from commit 948523d8527fb618d19b6286d71b4a9ef18287ab)
---
 .../server/pm/ext/PackageHooksRegistry.java   |  2 +
 .../pm/ext/PixelCameraServicesHooks.java      | 59 +++++++++++++++++++
 2 files changed, 61 insertions(+)
 create mode 100644 services/core/java/com/android/server/pm/ext/PixelCameraServicesHooks.java

diff --git a/services/core/java/com/android/server/pm/ext/PackageHooksRegistry.java b/services/core/java/com/android/server/pm/ext/PackageHooksRegistry.java
index 32982704fa..807bb39199 100644
--- a/services/core/java/com/android/server/pm/ext/PackageHooksRegistry.java
+++ b/services/core/java/com/android/server/pm/ext/PackageHooksRegistry.java
@@ -16,6 +16,7 @@ public class PackageHooksRegistry {
             case PackageId.GSF_NAME -> new GsfParsingHooks();
             case PackageId.EUICC_SUPPORT_PIXEL_NAME -> new EuiccSupportPixelHooks.ParsingHooks();
             case PackageId.G_EUICC_LPA_NAME -> new EuiccGoogleHooks.ParsingHooks();
