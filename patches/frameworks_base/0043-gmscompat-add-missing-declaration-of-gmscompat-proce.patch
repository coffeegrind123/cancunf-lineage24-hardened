From f12d429d3b870ba8e7bba5b78a35049c8524c0e1 Mon Sep 17 00:00:00 2001
From: Dmitry Muhomor <muhomor.dmitry@gmail.com>
Date: Tue, 20 Oct 2026 03:09:59 +0000
Subject: [PATCH 43/67] gmscompat: add missing declaration of gmscompat process

Recent versions of GSA (Google Search app) started declaring the list of processes explicitly via
the <processes> tag, which requires all app processes to be listed. Otherwise package installation
fails with the INSTALL_FAILED_PROCESS_NOT_DEFINED error.

(cherry picked from commit 49d3b64d89fccdec89c79d1ecdf8ee6ebfdc291f)
---
 .../server/pm/ext/GmsCompatPkgParsingHooks.java     | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/services/core/java/com/android/server/pm/ext/GmsCompatPkgParsingHooks.java b/services/core/java/com/android/server/pm/ext/GmsCompatPkgParsingHooks.java
index 5c9216efc1..fdf1e23296 100644
--- a/services/core/java/com/android/server/pm/ext/GmsCompatPkgParsingHooks.java
+++ b/services/core/java/com/android/server/pm/ext/GmsCompatPkgParsingHooks.java
@@ -10,12 +10,15 @@ import android.os.Bundle;
 
 import com.android.internal.gmscompat.GmsCompatApp;
 import com.android.internal.gmscompat.client.GmsCompatClientService;
+import com.android.internal.pm.pkg.component.ParsedProcess;
+import com.android.internal.pm.pkg.component.ParsedProcessImpl;
 import com.android.internal.pm.pkg.component.ParsedService;
 import com.android.internal.pm.pkg.component.ParsedServiceImpl;
 import com.android.internal.pm.pkg.component.ParsedUsesPermissionImpl;
 import com.android.internal.pm.pkg.parsing.PackageParsingHooks;
 import com.android.internal.pm.pkg.parsing.ParsingPackage;
 
+import java.util.ArrayList;
 import java.util.List;
 
 public class GmsCompatPkgParsingHooks extends PackageParsingHooks {
@@ -59,6 +62,16 @@ public class GmsCompatPkgParsingHooks extends PackageParsingHooks {
         return s;
     }
 
+    @CallSuper
+    @Override
+    public List<ParsedProcess> addProcesses(ParsingPackage pkg) {
+        var p = new ParsedProcessImpl();
+        p.setName(GmsCompat.gmsCompatProcessNameForPackage(pkg.getPackageName()));
+        var res = new ArrayList<ParsedProcess>();
+        res.add(p);
+        return res;
+    }
+
     @CallSuper
     @Override
     public List<ParsedUsesPermissionImpl> addUsesPermissions() {
