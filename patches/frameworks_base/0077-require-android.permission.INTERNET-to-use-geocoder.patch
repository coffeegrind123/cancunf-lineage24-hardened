-            mGeocodeProvider.forwardGeocode(request, callback);
+        if (mGeocodeProvider != null && GEOCODER_SETTING.get(mContext) != GEOCODER_DISABLED) {
+            boolean hasInternetPerm = mContext.checkCallingPermission(
