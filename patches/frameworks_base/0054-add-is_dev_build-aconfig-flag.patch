From 562345666c09043f829638fab44955a5f519defc Mon Sep 17 00:00:00 2001
From: Dmitry Muhomor <muhomor.dmitry@gmail.com>
Date: Mon, 20 Oct 2025 22:53:06 +0300
Subject: [PATCH 54/67] add is_dev_build aconfig flag

(cherry picked from commit 2bbf28680d4d990d60c706f13c55a5cb6e967fc6)
---
 core/java/android/os/flags.aconfig | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/core/java/android/os/flags.aconfig b/core/java/android/os/flags.aconfig
index deb576d1ce..883a0a0289 100644
--- a/core/java/android/os/flags.aconfig
+++ b/core/java/android/os/flags.aconfig
@@ -1,6 +1,15 @@
 package: "android.os"
 container: "system"
 
+flag {
+    name: "is_dev_build"
+    is_exported: true
+    namespace: "system_performance"
+    description: "A flag that allows code optimizer to remove userdebug/eng-only code from production OS builds."
+    is_fixed_read_only: true
+    bug: "0" # required field
+}
+
 # keep-sorted start block=yes newline_separated=yes
 flag {
     name: "adpf_audio_performance"
