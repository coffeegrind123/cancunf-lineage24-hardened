From 59c150efef898a0a7c8d0dd813e49879c071a068 Mon Sep 17 00:00:00 2001
From: lineage-build <build@localhost>
Date: Sat, 14 Nov 2026 16:31:57 +0000
Subject: [PATCH] cancunf: Point the Updater at our OTA feed

Releases are published as GitHub releases with a JSON feed on the
repository's ota branch. The Updater fetches the feed without
following redirects, so it is read from raw.githubusercontent.com.
Every build reads the same feed.json, which lists the full OTA and
the incrementals; the Updater keeps the entries for the running build.
---
 lineage_cancunf.mk | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/lineage_cancunf.mk b/lineage_cancunf.mk
index d248ffd..ef06007 100644
--- a/lineage_cancunf.mk
+++ b/lineage_cancunf.mk
@@ -29,3 +29,13 @@ PRODUCT_GMS_CLIENTID_BASE := android-motorola
 
 PRODUCT_BUILD_PROP_OVERRIDES += \
     DeviceName=cancunf
+
+# OTA feed for the Updater, published by build/publish.sh in
+# github.com/coffeegrind123/cancunf-lineage24-hardened. raw.githubusercontent
+# serves it without a redirect, which the Updater does not follow. The
+# feed lists the full OTA and every incremental; the Updater (patch 0001)
+# keeps only what applies to the running build, so every build, published or
+# not, reads the same file. Property values are capped at 91 bytes; this one
+# is 89.
+PRODUCT_SYSTEM_PROPERTIES += \
+    lineage.updater.uri=https://raw.githubusercontent.com/coffeegrind123/cancunf-lineage24-hardened/ota/feed.json
