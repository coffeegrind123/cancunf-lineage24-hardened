From 64a968990d9ec799841ff9a94febf3271f475d5f Mon Sep 17 00:00:00 2001
From: lineage-build <build@localhost>
Date: Wed, 11 Nov 2026 00:05:17 +0000
Subject: [PATCH] cancunf: Prune trees Soong never needs for this device

Full-tree Soong analysis holds tens of GB of live heap. Skip Android.bp
files this device cannot use (CTS and platform test trees, automotive
SDV, Qualcomm, Google device and sample trees) while keeping everything
another kept module references. soong-prune.mk is generated; prefixes
end in a slash because blueprint matches them as plain string prefixes.
---
 device.mk      |   7 +
 soong-prune.mk | 692 +++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 699 insertions(+)
 create mode 100644 soong-prune.mk

diff --git a/device.mk b/device.mk
index 6c9046d..7a44165 100644
--- a/device.mk
+++ b/device.mk
@@ -453,3 +453,10 @@ PRODUCT_COPY_FILES += \
 # Inherit the proprietary files
 $(call inherit-product, vendor/motorola/cancunf/cancunf-vendor.mk)
 $(call inherit-product, vendor/motorola/cancunf-motcamera/cancunf-motcamera-vendor.mk)
+
+# Soong analysis memory
+# Keep Soong from parsing trees this device never builds from. Analysis of the
+# full tree needs over 11 GB of live heap, which a memory-capped build host
+# cannot give it. Generated so that nothing still in the build depends on a
+# pruned module (shared CTS libraries and defaults stay).
+include $(DEVICE_PATH)/soong-prune.mk
diff --git a/soong-prune.mk b/soong-prune.mk
new file mode 100644
index 0000000..7bcd20a
--- /dev/null
+++ b/soong-prune.mk
@@ -0,0 +1,692 @@
