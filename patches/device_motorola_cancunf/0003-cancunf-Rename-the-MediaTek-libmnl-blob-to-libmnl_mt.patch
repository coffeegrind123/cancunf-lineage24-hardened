From 42eedce4efe87ee1b160f9df00545b25f267570d Mon Sep 17 00:00:00 2001
From: lineage-build <build@localhost>
Date: Tue, 10 Nov 2026 22:46:44 +0000
Subject: [PATCH] cancunf: Rename the MediaTek libmnl blob to libmnl_mtk

On LineageOS 24 external/libmnl is vendor_available, so the preferred
vendor prebuilt named libmnl now replaces it across partitions and Soong
fails with "partition is different: system(libmnl) != vendor". Rename
the blob with FIX_SONAME and point mnld at it, as mt6895-common does.
---
 extract-files.py      | 6 ++++--
 proprietary-files.txt | 2 +-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/extract-files.py b/extract-files.py
index 426ded4..619c2b8 100755
--- a/extract-files.py
+++ b/extract-files.py
@@ -66,8 +66,10 @@ blob_fixups: blob_fixups_user_type = {
         .replace_needed('android.hardware.security.keymint-V1-ndk_platform.so', 'android.hardware.security.keymint-V1-ndk.so')
         .replace_needed('android.hardware.security.sharedsecret-V1-ndk_platform.so', 'android.hardware.security.sharedsecret-V1-ndk.so')
         .replace_needed('android.hardware.security.secureclock-V1-ndk_platform.so', 'android.hardware.security.secureclock-V1-ndk.so'),
+    'vendor/bin/mnld': blob_fixup()
+        .add_needed('android.hardware.sensors@1.0-convert-shared.so')
+        .replace_needed('libmnl.so', 'libmnl_mtk.so'),
     (
-        'vendor/bin/mnld',
         'vendor/lib64/hw/android.hardware.sensors@2.X-subhal-mediatek.so',
         'vendor/lib64/mt6855/libcam.utils.sensorprovider.so'
     ): blob_fixup()
@@ -95,7 +97,7 @@ blob_fixups: blob_fixups_user_type = {
         'vendor/lib64/lib3a.ae.pipe.so'
     ): blob_fixup()
         .add_needed('liblog.so'),
-    'vendor/lib64/mt6855/libmnl.so': blob_fixup()
+    'vendor/lib64/mt6855/libmnl_mtk.so': blob_fixup()
         .add_needed('libcutils.so'),
     'vendor/etc/vintf/manifest/manifest_media_c2_V1_2_default.xml': blob_fixup()
         .regex_replace('1.1', '1.2')
diff --git a/proprietary-files.txt b/proprietary-files.txt
index f997365..e739647 100644
--- a/proprietary-files.txt
+++ b/proprietary-files.txt
@@ -2674,7 +2674,7 @@ vendor/lib/vendor.mediatek.hardware.mms@1.5.so
 vendor/lib/vendor.mediatek.hardware.mms@1.6.so
 vendor/lib/vendor.mediatek.hardware.rcs@2.0.so
 vendor/lib64/hw/vendor.mediatek.hardware.mms@1.6-impl.so
-vendor/lib64/mt6855/libmnl.so;SYMLINK=vendor/lib64/libmnl.so
+vendor/lib64/mt6855/libmnl.so:vendor/lib64/mt6855/libmnl_mtk.so;SYMLINK=vendor/lib64/libmnl_mtk.so;FIX_SONAME
 vendor/lib64/libMtkAinrEnh.so
 vendor/lib64/libadropbox.so
 vendor/lib64/libcapctrl.so
-- 
2.43.0

