From d7a1f7297e010d8bc0c0721a41da4d3345512a6c Mon Sep 17 00:00:00 2001
From: lineage-build <build@localhost>
Date: Tue, 10 Nov 2026 22:42:38 +0000
Subject: [PATCH] cancunf: Stop treating hardware/mediatek/libaedv as a
 namespace

LineageOS 24 hardware/mediatek replaced the namespaced libaedv with a
stub in the parent hardware/mediatek namespace (02900b51eb), so Soong
fails with "namespace hardware/mediatek/libaedv does not exist".
---
 device.mk        | 1 -
 extract-files.py | 1 -
 2 files changed, 2 deletions(-)

diff --git a/device.mk b/device.mk
index 0a54bfa..72d4211 100644
--- a/device.mk
+++ b/device.mk
@@ -406,7 +406,6 @@ PRODUCT_SOONG_NAMESPACES += \
     hardware/google/interfaces \
     hardware/google/pixel \
     hardware/mediatek \
-    hardware/mediatek/libaedv \
     hardware/mediatek/libmtkperf_client \
     hardware/mediatek/wlan/wifi_hal \
     $(DEVICE_PATH)
diff --git a/extract-files.py b/extract-files.py
index f4ad74e..426ded4 100755
--- a/extract-files.py
+++ b/extract-files.py
@@ -20,7 +20,6 @@ from extract_utils.main import (
 namespace_imports = [
     'device/motorola/cancunf',
     'hardware/mediatek',
-    'hardware/mediatek/libaedv',
     'hardware/mediatek/libmtkperf_client',
 ]
 
-- 
2.43.0

