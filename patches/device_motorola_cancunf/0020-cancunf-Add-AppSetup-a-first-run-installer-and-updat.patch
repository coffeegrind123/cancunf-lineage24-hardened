@@ -0,0 +1,38 @@
+package app.cancunf.appsetup;
+
+import android.content.Context;
+import android.net.Uri;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Set;
+
+/** Aurora Store from the release feed Aurora itself uses for self-updates. */
+final class AuroraFeedSource implements Source {
+
+    private static final String FEED_URL = "https://auroraoss.com/downloads/AuroraStore/Feeds/release_feed.json";
+    private static final Set<String> HOSTS = Set.of("auroraoss.com", "www.auroraoss.com");
+
+    @Override
+    public Release latest(Context ctx, RunState run) throws IOException {
+        byte[] body = Http.get(FEED_URL, Http.METADATA_MAX, "application/json");
+        try {
+            JSONObject f = new JSONObject(new String(body, StandardCharsets.UTF_8));
+            String url = f.getString("download_url");
+            Uri u = Uri.parse(url);
+            if (!"https".equals(u.getScheme()) || !HOSTS.contains(u.getHost())) {
+                throw new IOException("Aurora feed points outside auroraoss.com: " + url);
+            }
+            long vc = Long.parseLong(f.getString("version_code").trim());
+            long size = Long.parseLong(f.getString("size").trim());
+            return new Release(Catalog.AURORA, vc, f.getString("version_name"),
+                    List.of(new Release.Part("base.apk", url, null, size)));
+        } catch (JSONException | NumberFormatException e) {
+            throw new IOException("malformed Aurora feed", e);
+        }
+    }
+}
