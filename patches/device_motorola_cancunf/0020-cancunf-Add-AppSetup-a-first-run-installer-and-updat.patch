diff --git a/apps/AppSetup/Android.bp b/apps/AppSetup/Android.bp
new file mode 100644
index 0000000..314b734
--- /dev/null
+++ b/apps/AppSetup/Android.bp
@@ -0,0 +1,24 @@
+// First-run installer and updater for apps that ship outside the image:
+// sandboxed Google Play (from GrapheneOS's app repository), Aurora Store,
+// F-Droid and Titanium Browser. Every download must be signed by a pinned
+// certificate (Catalog.java) before it is installed.
+android_app {
+    name: "AppSetup",
+    srcs: ["src/**/*.java"],
+    resource_dirs: ["res"],
+    manifest: "AndroidManifest.xml",
+    platform_apis: true,
+    privileged: true,
+    system_ext_specific: true,
+    required: ["privapp-permissions-appsetup.xml"],
+    optimize: {
+        enabled: false,
+    },
+}
+
+prebuilt_etc {
+    name: "privapp-permissions-appsetup.xml",
+    src: "privapp-permissions-appsetup.xml",
+    sub_dir: "permissions",
+    system_ext_specific: true,
+}
