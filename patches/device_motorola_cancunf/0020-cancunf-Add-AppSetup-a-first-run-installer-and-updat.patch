--- /dev/null
+++ b/apps/AppSetup/src/app/cancunf/appsetup/RunState.java
@@ -0,0 +1,103 @@
+package app.cancunf.appsetup;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.security.KeyFactory;
+import java.security.PublicKey;
+import java.security.Signature;
+import java.security.spec.X509EncodedKeySpec;
+import java.util.Arrays;
+import java.util.Base64;
+
+/** State shared by the sources during one run. */
+final class RunState {
+
+    private static final String GRAPHENE_INDEX_URL = "https://apps.grapheneos.org/metadata.1.0.sjson";
+
+    // GrapheneOS app repository signing key (signify/minisign Ed25519 format), as
+    // pinned in GrapheneOS's own App Store client (app/build.gradle.kts).
+    private static final String GRAPHENE_REPO_KEY = "RWQtZwEu1br1lMh911L3yPOs97cQb9LOks/ALBbqGl21ul695ocWR/ir";
+
+    // DER prefix that turns a raw 32-byte Ed25519 key into a SubjectPublicKeyInfo.
+    private static final byte[] ED25519_SPKI_PREFIX = {
+        0x30, 0x2a, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x03, 0x21, 0x00,
+    };
+    // Signature trailer: '\n', 100 base64 characters, '\n'.
+    private static final int SIG_B64_LEN = 100;
+
+    private static final String PREFS = "state";
+    private static final String KEY_GRAPHENE_TIME = "graphene_index_time";
+
+    private final Context ctx;
+    private JSONObject grapheneIndex;
+
+    RunState(Context ctx) {
+        this.ctx = ctx;
+    }
+
+    /**
+     * GrapheneOS's app index, signature-checked against the pinned key and
+     * refused if older than one already seen (a replayed old index could steer
+     * us to old, known-vulnerable versions).
+     */
+    JSONObject grapheneIndex() throws IOException {
+        if (grapheneIndex != null) {
+            return grapheneIndex;
+        }
+        byte[] data = Http.get(GRAPHENE_INDEX_URL, Http.METADATA_MAX, null);
+        byte[] body = verifySignify(data);
+        JSONObject index;
+        long time;
+        try {
+            index = new JSONObject(new String(body, StandardCharsets.UTF_8));
+            time = index.getLong("time");
+        } catch (JSONException e) {
+            throw new IOException("malformed GrapheneOS index", e);
+        }
+        SharedPreferences prefs = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        long seen = prefs.getLong(KEY_GRAPHENE_TIME, 0);
+        if (time < seen) {
+            throw new IOException("GrapheneOS index is older than one already seen (" + time + " < " + seen + ")");
+        }
+        prefs.edit().putLong(KEY_GRAPHENE_TIME, time).apply();
+        grapheneIndex = index;
+        return index;
+    }
+
+    static byte[] verifySignify(byte[] data) throws IOException {
+        int n = data.length;
+        if (n < SIG_B64_LEN + 2 || data[n - 1] != '\n' || data[n - SIG_B64_LEN - 2] != '\n') {
+            throw new IOException("GrapheneOS index has no signature trailer");
+        }
+        byte[] body = Arrays.copyOfRange(data, 0, n - SIG_B64_LEN - 2);
+        byte[] sig = Base64.getDecoder().decode(Arrays.copyOfRange(data, n - SIG_B64_LEN - 1, n - 1));
+        byte[] key = Base64.getDecoder().decode(GRAPHENE_REPO_KEY);
+        // Both blobs: 2-byte algorithm "Ed", 8-byte key id, then the key or signature.
+        if (sig.length != 74 || key.length != 42 || sig[0] != 'E' || sig[1] != 'd'
+                || !Arrays.equals(Arrays.copyOfRange(sig, 2, 10), Arrays.copyOfRange(key, 2, 10))) {
+            throw new IOException("GrapheneOS index signed by an unexpected key");
+        }
+        try {
+            byte[] spki = new byte[ED25519_SPKI_PREFIX.length + 32];
+            System.arraycopy(ED25519_SPKI_PREFIX, 0, spki, 0, ED25519_SPKI_PREFIX.length);
+            System.arraycopy(key, 10, spki, ED25519_SPKI_PREFIX.length, 32);
+            PublicKey pub = KeyFactory.getInstance("Ed25519").generatePublic(new X509EncodedKeySpec(spki));
+            Signature v = Signature.getInstance("Ed25519");
+            v.initVerify(pub);
+            v.update(body);
+            if (!v.verify(Arrays.copyOfRange(sig, 10, 74))) {
+                throw new IOException("GrapheneOS index signature is invalid");
+            }
+        } catch (GeneralSecurityException e) {
+            throw new IOException("cannot verify GrapheneOS index", e);
+        }
+        return body;
+    }
+}
