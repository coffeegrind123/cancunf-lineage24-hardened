@@ -0,0 +1,49 @@
+package app.cancunf.appsetup;
+
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.content.pm.SigningInfo;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.Set;
+
+/** The gate between a download and the installer. */
+final class Verifier {
+
+    /**
+     * Checks a downloaded base APK: right package, signed by a pinned
+     * certificate (every current signer when there are several), and the version
+     * the source announced. Returns the archive's version code.
+     */
+    static long check(PackageManager pm, File base, String pkg, Set<String> pins, long expectedVersionCode)
+            throws IOException {
+        PackageInfo pi = pm.getPackageArchiveInfo(base.getPath(),
+                PackageManager.PackageInfoFlags.of(PackageManager.GET_SIGNING_CERTIFICATES));
+        if (pi == null) {
+            throw new IOException("not a valid APK");
+        }
+        if (!pkg.equals(pi.packageName)) {
+            throw new IOException("APK is " + pi.packageName + ", expected " + pkg);
+        }
+        SigningInfo si = pi.signingInfo;
+        Signature[] signers = si == null ? null : si.getApkContentsSigners();
+        if (signers == null || signers.length == 0) {
+            throw new IOException("APK has no signing certificate");
+        }
+        for (Signature s : signers) {
+            String digest = Util.sha256Hex(s.toByteArray());
+            if (!pins.contains(digest)) {
+                throw new IOException("APK signed by an unknown certificate " + digest);
+            }
+        }
+        long vc = pi.getLongVersionCode();
+        if (expectedVersionCode != Release.UNKNOWN && vc != expectedVersionCode) {
+            throw new IOException("APK is version " + vc + ", source announced " + expectedVersionCode);
+        }
+        return vc;
+    }
+
+    private Verifier() {}
+}
