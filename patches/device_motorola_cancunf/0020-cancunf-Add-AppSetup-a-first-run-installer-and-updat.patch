@@ -0,0 +1,43 @@
+package app.cancunf.appsetup;
+
+import java.util.List;
+
+/** One installable version of an app, as a source describes it. */
+final class Release {
+
+    static final long UNKNOWN = -1;
+
+    /** One APK file of the release: the base, or a split. */
+    static final class Part {
+        final String name;
+        final String url;
+        /** Lowercase hex SHA-256 when the source publishes one, else null. */
+        final String sha256;
+        /** Exact size when known, else UNKNOWN. */
+        final long size;
+
+        Part(String name, String url, String sha256, long size) {
+            this.name = name;
+            this.url = url;
+            this.sha256 = sha256;
+            this.size = size;
+        }
+    }
+
+    final String pkg;
+    /** UNKNOWN when the source only names the version (GitHub releases). */
+    final long versionCode;
+    final String versionName;
+    /** The first part is the base APK. */
+    final List<Part> parts;
+
+    Release(String pkg, long versionCode, String versionName, List<Part> parts) {
+        if (parts.isEmpty()) {
+            throw new IllegalArgumentException("release without files: " + pkg);
+        }
+        this.pkg = pkg;
+        this.versionCode = versionCode;
+        this.versionName = versionName;
+        this.parts = parts;
+    }
+}
diff --git a/apps/AppSetup/src/app/cancunf/appsetup/RunState.java b/apps/AppSetup/src/app/cancunf/appsetup/RunState.java
