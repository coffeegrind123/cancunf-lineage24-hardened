+package app.cancunf.appsetup;
+
+import android.app.job.JobInfo;
+import android.app.job.JobParameters;
+import android.app.job.JobScheduler;
+import android.app.job.JobService;
+import android.content.ComponentName;
+import android.content.Context;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Daily update check on an unmetered network. It only updates apps that are
+ * already installed: an app the user removed stays removed.
+ */
+public class UpdateJobService extends JobService {
+
+    private static final int JOB_ID = 1;
+    private static final long INTERVAL_MS = 24L * 60 * 60 * 1000;
+
+    private final ExecutorService worker = Executors.newSingleThreadExecutor();
+
+    static void schedule(Context ctx) {
+        JobScheduler js = ctx.getSystemService(JobScheduler.class);
+        if (js.getPendingJob(JOB_ID) != null) {
+            return;
+        }
+        js.schedule(new JobInfo.Builder(JOB_ID, new ComponentName(ctx, UpdateJobService.class))
+                .setRequiredNetworkType(JobInfo.NETWORK_TYPE_UNMETERED)
+                .setRequiresBatteryNotLow(true)
+                .setPeriodic(INTERVAL_MS)
+                .setPersisted(true)
+                .build());
+    }
+
+    @Override
+    public boolean onStartJob(JobParameters params) {
+        worker.execute(() -> {
+            Engine.run(getApplicationContext(), Catalog.apps(), Engine.Mode.UPDATE_ONLY, null);
+            jobFinished(params, false);
+        });
+        return true;
+    }
+
+    @Override
+    public boolean onStopJob(JobParameters params) {
+        // Retry at the next window; a half-written session is abandoned by Installer.
+        worker.shutdownNow();
+        return true;
+    }
+}
diff --git a/apps/AppSetup/src/app/cancunf/appsetup/Util.java b/apps/AppSetup/src/app/cancunf/appsetup/Util.java
