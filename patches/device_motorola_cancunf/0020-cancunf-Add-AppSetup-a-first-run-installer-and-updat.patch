new file mode 100644
index 0000000..acd768f
--- /dev/null
+++ b/apps/AppSetup/src/app/cancunf/appsetup/MainActivity.java
@@ -0,0 +1,126 @@
+package app.cancunf.appsetup;
+
+import android.app.Activity;
+import android.content.pm.PackageInfo;
+import android.os.Bundle;
+import android.util.TypedValue;
+import android.view.View;
+import android.widget.Button;
+import android.widget.CheckBox;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/** A checklist of the managed apps: install the selected ones, or update what is installed. */
+public class MainActivity extends Activity {
+
+    private final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private final Map<String, CheckBox> boxes = new HashMap<>();
+    private final Map<String, TextView> statuses = new HashMap<>();
+    private Button installButton;
+    private Button updateButton;
+    private boolean busy;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        UpdateJobService.schedule(this);
+
+        int pad = dp(16);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(pad, pad, pad, pad);
+
+        TextView intro = new TextView(this);
+        intro.setText(R.string.intro);
+        intro.setPadding(0, 0, 0, pad);
+        root.addView(intro);
+
+        for (Catalog.App app : Catalog.apps()) {
+            CheckBox box = new CheckBox(this);
+            box.setText(app.label);
+            box.setChecked(true);
+            root.addView(box);
+            boxes.put(app.pkg, box);
+
+            TextView status = new TextView(this);
+            status.setPadding(dp(32), 0, 0, dp(8));
+            root.addView(status);
+            statuses.put(app.pkg, status);
+        }
+
+        installButton = new Button(this);
+        installButton.setText(R.string.install_selected);
+        installButton.setOnClickListener(v -> start(Engine.Mode.INSTALL, true));
+        root.addView(installButton);
+
+        updateButton = new Button(this);
+        updateButton.setText(R.string.check_updates);
+        updateButton.setOnClickListener(v -> start(Engine.Mode.UPDATE_ONLY, false));
+        root.addView(updateButton);
+
+        ScrollView scroll = new ScrollView(this);
+        scroll.setFitsSystemWindows(true);
+        scroll.addView(root);
+        setContentView(scroll);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        if (!busy) {
+            showInstalledVersions();
+        }
+    }
+
+    @Override
+    protected void onDestroy() {
+        worker.shutdownNow();
+        super.onDestroy();
+    }
+
+    private void showInstalledVersions() {
+        for (Catalog.App app : Catalog.apps()) {
+            PackageInfo pi = Util.installed(getPackageManager(), app.pkg);
+            statuses.get(app.pkg).setText(pi == null
+                    ? getString(R.string.not_installed)
+                    : getString(R.string.installed_version, pi.versionName));
+        }
+    }
+
+    private void start(Engine.Mode mode, boolean selectedOnly) {
+        List<Catalog.App> apps = new ArrayList<>();
+        for (Catalog.App app : Catalog.apps()) {
+            if (!selectedOnly || boxes.get(app.pkg).isChecked()) {
+                apps.add(app);
+            }
+        }
+        setBusy(true);
+        worker.execute(() -> {
+            Engine.run(getApplicationContext(), apps, mode,
+                    (pkg, status) -> runOnUiThread(() -> statuses.get(pkg).setText(status)));
+            runOnUiThread(() -> setBusy(false));
+        });
+    }
+
+    private void setBusy(boolean b) {
+        busy = b;
+        installButton.setEnabled(!b);
+        updateButton.setEnabled(!b);
+        for (CheckBox box : boxes.values()) {
+            box.setEnabled(!b);
+        }
+        installButton.setText(b ? R.string.working : R.string.install_selected);
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, getResources().getDisplayMetrics());
+    }
+}
