@@ -0,0 +1,30 @@
+package app.cancunf.appsetup;
+
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+
+final class Util {
+
+    static String hex(byte[] b) {
+        StringBuilder sb = new StringBuilder(b.length * 2);
+        for (byte x : b) {
+            sb.append(Character.forDigit((x >> 4) & 0xf, 16)).append(Character.forDigit(x & 0xf, 16));
+        }
+        return sb.toString();
+    }
+
+    static String sha256Hex(byte[] data) {
+        return hex(Http.sha256().digest(data));
+    }
+
+    /** The installed package, or null. */
+    static PackageInfo installed(PackageManager pm, String pkg) {
+        try {
+            return pm.getPackageInfo(pkg, PackageManager.PackageInfoFlags.of(0));
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+    }
+
+    private Util() {}
+}
