--- /dev/null
+++ b/apps/AppSetup/src/app/cancunf/appsetup/GrapheneRepoSource.java
@@ -0,0 +1,212 @@
+package app.cancunf.appsetup;
+
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.os.Build;
+import android.os.LocaleList;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Sandboxed Google Play packages from GrapheneOS's app repository: Google's
+ * own signed APKs, listed in an index GrapheneOS signs. Variant and split
+ * choice follows what GrapheneOS's App Store client does for this device.
+ */
+final class GrapheneRepoSource implements Source {
+
+    private static final String PACKAGES_URL = "https://apps.grapheneos.org/packages/";
+    private static final String ANDROID_DEP = "android";
+
+    private static final String[] DENSITY_NAMES = {"ldpi", "mdpi", "tvdpi", "hdpi", "xhdpi", "xxhdpi", "xxxhdpi"};
+    private static final int[] DENSITY_DPI = {120, 160, 213, 240, 320, 480, 640};
+
+    private final String pkg;
+
+    GrapheneRepoSource(String pkg) {
+        this.pkg = pkg;
+    }
+
+    @Override
+    public Release latest(Context ctx, RunState run) throws IOException {
+        try {
+            JSONObject p = run.grapheneIndex().getJSONObject("packages").optJSONObject(pkg);
+            if (p == null || !depsMet(ctx, p.optJSONArray("staticDeps"))) {
+                return null;
+            }
+            JSONObject variants = p.getJSONObject("variants");
+            JSONObject best = null;
+            for (Iterator<String> it = variants.keys(); it.hasNext(); ) {
+                JSONObject v = variants.getJSONObject(it.next());
+                if (suits(ctx, v) && (best == null || v.getLong("versionCode") > best.getLong("versionCode"))) {
+                    best = v;
+                }
+            }
+            return best == null ? null : toRelease(ctx, best);
+        } catch (JSONException e) {
+            throw new IOException("malformed GrapheneOS index entry for " + pkg, e);
+        }
+    }
+
+    private boolean suits(Context ctx, JSONObject v) throws JSONException {
+        if (!"stable".equals(v.optString("channel", "stable"))) {
+            return false;
+        }
+        if (v.optInt("minSdk", 0) > Build.VERSION.SDK_INT) {
+            return false;
+        }
+        if (v.has("maxSdk") && v.getInt("maxSdk") < Build.VERSION.SDK_INT) {
+            return false;
+        }
+        JSONArray abis = v.optJSONArray("abis");
+        if (abis != null && !contains(abis, Build.SUPPORTED_ABIS[0])) {
+            return false;
+        }
+        return depsMet(ctx, v.optJSONArray("staticDeps"));
+    }
+
+    /** Dependencies look like "app.grapheneos.gmscompat >= 1011" or "android < 35". */
+    private static boolean depsMet(Context ctx, JSONArray deps) throws JSONException {
+        if (deps == null) {
+            return true;
+        }
+        for (int i = 0; i < deps.length(); i++) {
+            String[] t = deps.getString(i).trim().split("\\s+");
+            if (t.length != 3) {
+                return false;
+            }
+            long have;
+            if (ANDROID_DEP.equals(t[0])) {
+                have = Build.VERSION.SDK_INT;
+            } else {
+                PackageInfo pi = Util.installed(ctx.getPackageManager(), t[0]);
+                if (pi == null) {
+                    return false;
+                }
+                have = pi.getLongVersionCode();
+            }
+            long want = Long.parseLong(t[2]);
+            boolean ok;
+            switch (t[1]) {
+                case ">=": ok = have >= want; break;
+                case ">": ok = have > want; break;
+                case "<=": ok = have <= want; break;
+                case "<": ok = have < want; break;
+                case "==": ok = have == want; break;
+                default: ok = false;
+            }
+            if (!ok) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private Release toRelease(Context ctx, JSONObject v) throws JSONException {
+        long vc = v.getLong("versionCode");
+        JSONArray names = v.getJSONArray("apks");
+        JSONArray hashes = v.getJSONArray("apkHashes");
+        JSONArray sizes = v.getJSONArray("apkSizes");
+        if (names.length() != hashes.length() || names.length() != sizes.length()) {
+            throw new JSONException("apks, apkHashes and apkSizes differ in length");
+        }
+
+        String abi = Build.SUPPORTED_ABIS[0].replace('-', '_');
+        String density = pickDensity(ctx, names);
+        Set<String> langs = wantedLanguages(ctx);
+
+        List<Release.Part> parts = new ArrayList<>();
+        for (int i = 0; i < names.length(); i++) {
+            String name = names.getString(i);
+            if (!keep(name, abi, density, langs)) {
+                continue;
+            }
+            Release.Part part = new Release.Part(name, PACKAGES_URL + pkg + "/" + vc + "/" + name,
+                    hashes.getString(i), sizes.getLong(i));
+            if ("base.apk".equals(name)) {
+                parts.add(0, part);
+            } else {
+                parts.add(part);
+            }
+        }
+        if (parts.isEmpty() || !"base.apk".equals(parts.get(0).name)) {
+            throw new JSONException("variant " + vc + " of " + pkg + " has no base.apk");
+        }
+        return new Release(pkg, vc, v.optString("versionName", String.valueOf(vc)), parts);
+    }
+
+    /** The configuration qualifier of a config split, or null for base and feature splits. */
+    private static String qualifier(String name) {
+        String stem = name.endsWith(".apk") ? name.substring(0, name.length() - 4) : name;
+        if (stem.startsWith("split_config.")) {
+            return stem.substring("split_config.".length());
+        }
+        int i = stem.indexOf(".config.");
+        return i < 0 ? null : stem.substring(i + ".config.".length());
+    }
+
+    private static boolean keep(String name, String abi, String density, Set<String> langs) {
+        String q = qualifier(name);
+        if (q == null) {
+            return true;
+        }
+        if (q.equals("arm64_v8a") || q.equals("armeabi_v7a") || q.equals("x86") || q.equals("x86_64")) {
+            return q.equals(abi);
+        }
+        if (q.endsWith("dpi")) {
+            return q.equals(density);
+        }
+        return langs.contains(q);
+    }
+
+    /** The available density split closest to the screen, preferring the next larger one. */
+    private static String pickDensity(Context ctx, JSONArray names) throws JSONException {
+        Set<String> available = new HashSet<>();
+        for (int i = 0; i < names.length(); i++) {
+            String q = qualifier(names.getString(i));
+            if (q != null && q.endsWith("dpi")) {
+                available.add(q);
+            }
+        }
+        int dpi = ctx.getResources().getDisplayMetrics().densityDpi;
+        String larger = null;
+        String largest = null;
+        for (int i = 0; i < DENSITY_NAMES.length; i++) {
+            if (!available.contains(DENSITY_NAMES[i])) {
+                continue;
+            }
+            largest = DENSITY_NAMES[i];
+            if (larger == null && DENSITY_DPI[i] >= dpi) {
+                larger = DENSITY_NAMES[i];
+            }
+        }
+        return larger != null ? larger : largest;
+    }
+
+    private static Set<String> wantedLanguages(Context ctx) {
+        Set<String> langs = new HashSet<>();
+        langs.add("en");
+        LocaleList locales = ctx.getResources().getConfiguration().getLocales();
+        for (int i = 0; i < locales.size(); i++) {
+            langs.add(locales.get(i).getLanguage());
+        }
+        return langs;
+    }
+
+    private static boolean contains(JSONArray a, String s) throws JSONException {
+        for (int i = 0; i < a.length(); i++) {
+            if (s.equals(a.getString(i))) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
diff --git a/apps/AppSetup/src/app/cancunf/appsetup/Http.java b/apps/AppSetup/src/app/cancunf/appsetup/Http.java
new file mode 100644
index 0000000..5eafbdf
--- /dev/null
+++ b/apps/AppSetup/src/app/cancunf/appsetup/Http.java
@@ -0,0 +1,145 @@
+package app.cancunf.appsetup;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.net.URL;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+
+/**
+ * HTTPS-only fetching with hard size limits.
+ *
+ * Nothing here is trusted: metadata only decides what to download, and every
+ * APK is checked against its pinned certificate before install. The limits keep
+ * a hostile or broken server from filling storage or memory.
+ */
+final class Http {
+
+    static final int METADATA_MAX = 4 * 1024 * 1024;
+    private static final int CONNECT_TIMEOUT_MS = 20_000;
+    private static final int READ_TIMEOUT_MS = 60_000;
+    private static final int MAX_REDIRECTS = 5;
+    // Generic client name: requests carry nothing that identifies the user or device.
+    private static final String USER_AGENT = "AppSetup";
+
+    interface Progress {
+        void onBytes(long done, long total);
+    }
+
+    static byte[] get(String url, int maxBytes, String accept) throws IOException {
+        HttpURLConnection c = open(url, accept);
+        try (InputStream in = c.getInputStream()) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[16384];
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                if (out.size() + n > maxBytes) {
+                    throw new IOException("response larger than " + maxBytes + " bytes: " + url);
+                }
+                out.write(buf, 0, n);
+            }
+            return out.toByteArray();
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    /**
+     * Downloads to dest. When expectedSize is known the body must match it
+     * exactly; when expectedSha256 is known the hash must match too. Returns the
+     * lowercase hex SHA-256 of what was written.
+     */
+    static String download(String url, File dest, long maxBytes, long expectedSize,
+            String expectedSha256, Progress progress) throws IOException {
+        HttpURLConnection c = open(url, null);
+        MessageDigest md = sha256();
+        long total = expectedSize > 0 ? expectedSize : c.getContentLengthLong();
+        long done = 0;
+        try (InputStream in = c.getInputStream(); OutputStream out = new FileOutputStream(dest)) {
+            byte[] buf = new byte[65536];
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                done += n;
+                if (done > maxBytes || (expectedSize > 0 && done > expectedSize)) {
+                    throw new IOException("download larger than expected: " + url);
+                }
+                md.update(buf, 0, n);
+                out.write(buf, 0, n);
+                if (progress != null) {
+                    progress.onBytes(done, total);
+                }
+            }
+        } finally {
+            c.disconnect();
+        }
+        if (expectedSize > 0 && done != expectedSize) {
+            throw new IOException("size mismatch for " + url + ": " + done + " != " + expectedSize);
+        }
+        String got = Util.hex(md.digest());
+        if (expectedSha256 != null && !expectedSha256.equals(got)) {
+            throw new IOException("SHA-256 mismatch for " + url);
+        }
+        return got;
+    }
+
+    private static HttpURLConnection open(String url, String accept) throws IOException {
+        URI current;
+        try {
+            current = new URI(url);
+        } catch (URISyntaxException e) {
+            throw new IOException("malformed URL: " + url, e);
+        }
+        for (int hop = 0; hop <= MAX_REDIRECTS; hop++) {
+            if (!"https".equals(current.getScheme())) {
+                throw new IOException("refusing non-HTTPS URL: " + current);
+            }
+            URL u = current.toURL();
+            HttpURLConnection c = (HttpURLConnection) u.openConnection();
+            c.setConnectTimeout(CONNECT_TIMEOUT_MS);
+            c.setReadTimeout(READ_TIMEOUT_MS);
+            // Redirects are followed by hand so every hop is checked for HTTPS.
+            c.setInstanceFollowRedirects(false);
+            c.setRequestProperty("User-Agent", USER_AGENT);
+            if (accept != null) {
+                c.setRequestProperty("Accept", accept);
+            }
+            int code = c.getResponseCode();
+            if (code >= 300 && code < 400) {
+                String location = c.getHeaderField("Location");
+                c.disconnect();
+                if (location == null) {
+                    throw new IOException("redirect without Location: " + current);
+                }
+                try {
+                    current = current.resolve(new URI(location));
+                } catch (URISyntaxException e) {
+                    throw new IOException("malformed redirect from " + current + ": " + location, e);
+                }
+                continue;
+            }
+            if (code != HttpURLConnection.HTTP_OK) {
+                c.disconnect();
+                throw new IOException("HTTP " + code + " for " + current);
+            }
+            return c;
+        }
+        throw new IOException("too many redirects: " + url);
+    }
+
+    static MessageDigest sha256() {
+        try {
+            return MessageDigest.getInstance("SHA-256");
+        } catch (NoSuchAlgorithmException e) {
+            throw new AssertionError(e);
+        }
+    }
+
+    private Http() {}
+}
diff --git a/apps/AppSetup/src/app/cancunf/appsetup/Installer.java b/apps/AppSetup/src/app/cancunf/appsetup/Installer.java
new file mode 100644
index 0000000..cb2e1d6
--- /dev/null
+++ b/apps/AppSetup/src/app/cancunf/appsetup/Installer.java
@@ -0,0 +1,97 @@
+package app.cancunf.appsetup;
+
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.PackageInstaller;
+import android.content.pm.PackageManager;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+/** Installs a set of APKs (base plus splits) as one PackageInstaller session. */
+final class Installer {
+
+    private static final String ACTION_RESULT = "app.cancunf.appsetup.INSTALL_RESULT";
+    private static final long COMMIT_TIMEOUT_MIN = 15;
+
+    static void install(Context ctx, String pkg, List<File> apks) throws IOException {
+        PackageInstaller pi = ctx.getPackageManager().getPackageInstaller();
+        PackageInstaller.SessionParams params =
+                new PackageInstaller.SessionParams(PackageInstaller.SessionParams.MODE_FULL_INSTALL);
+        params.setAppPackageName(pkg);
+        params.setInstallReason(PackageManager.INSTALL_REASON_USER);
+        // INSTALL_PACKAGES makes this silent; the pinned-certificate check already ran.
+        params.setRequireUserAction(PackageInstaller.SessionParams.USER_ACTION_NOT_REQUIRED);
+        long total = 0;
+        for (File f : apks) {
+            total += f.length();
+        }
+        params.setSize(total);
+
+        int id = pi.createSession(params);
+        int[] status = {PackageInstaller.STATUS_FAILURE};
+        String[] message = {null};
+        CountDownLatch done = new CountDownLatch(1);
+        String action = ACTION_RESULT + "." + id;
+        BroadcastReceiver receiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context c, Intent intent) {
+                int s = intent.getIntExtra(PackageInstaller.EXTRA_STATUS, PackageInstaller.STATUS_FAILURE);
+                if (s == PackageInstaller.STATUS_PENDING_USER_ACTION) {
+                    // Should not happen with INSTALL_PACKAGES; if the system asks anyway, let the user answer.
+                    Intent confirm = intent.getParcelableExtra(Intent.EXTRA_INTENT, Intent.class);
+                    if (confirm != null) {
+                        c.startActivity(confirm.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+                    }
+                    return;
+                }
+                status[0] = s;
+                message[0] = intent.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE);
+                done.countDown();
+            }
+        };
+        ctx.registerReceiver(receiver, new IntentFilter(action), Context.RECEIVER_NOT_EXPORTED);
+        try (PackageInstaller.Session session = pi.openSession(id)) {
+            for (File f : apks) {
+                try (InputStream in = new FileInputStream(f);
+                        OutputStream out = session.openWrite(f.getName(), 0, f.length())) {
+                    byte[] buf = new byte[65536];
+                    int n;
+                    while ((n = in.read(buf)) > 0) {
+                        out.write(buf, 0, n);
+                    }
+                    session.fsync(out);
+                }
+            }
+            Intent intent = new Intent(action).setPackage(ctx.getPackageName());
+            PendingIntent result = PendingIntent.getBroadcast(ctx, id, intent,
+                    PendingIntent.FLAG_MUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+            session.commit(result.getIntentSender());
+            if (!done.await(COMMIT_TIMEOUT_MIN, TimeUnit.MINUTES)) {
+                throw new IOException("install of " + pkg + " timed out");
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IOException("interrupted installing " + pkg, e);
+        } catch (IOException | RuntimeException e) {
+            pi.abandonSession(id);
+            throw e;
+        } finally {
+            ctx.unregisterReceiver(receiver);
+        }
+        if (status[0] != PackageInstaller.STATUS_SUCCESS) {
+            throw new IOException("install of " + pkg + " failed (" + status[0] + "): " + message[0]);
+        }
+    }
+
+    private Installer() {}
+}
