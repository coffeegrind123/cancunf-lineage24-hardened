@@ -0,0 +1,16 @@
+package app.cancunf.appsetup;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/** Schedules the daily update check, so it runs even if the app was never opened. */
+public class BootReceiver extends BroadcastReceiver {
+
+    @Override
+    public void onReceive(Context ctx, Intent intent) {
+        if (Intent.ACTION_BOOT_COMPLETED.equals(intent.getAction())) {
+            UpdateJobService.schedule(ctx);
+        }
+    }
+}
diff --git a/apps/AppSetup/src/app/cancunf/appsetup/Catalog.java b/apps/AppSetup/src/app/cancunf/appsetup/Catalog.java
new file mode 100644
index 0000000..460e858
--- /dev/null
+++ b/apps/AppSetup/src/app/cancunf/appsetup/Catalog.java
@@ -0,0 +1,65 @@
+package app.cancunf.appsetup;
+
+import java.util.List;
+import java.util.Set;
+
+/**
+ * The managed apps and the signing certificates each one must carry.
+ *
+ * A pin is the SHA-256 of the APK's current signing certificate. They were read
+ * from the released APKs on 2026-11-16 and cross-checked: Aurora's against its
+ * README, F-Droid's against its long-published fingerprint, Titanium's against
+ * an older release (same key since at least June 2026), Google's against
+ * GrapheneOS's signed app index. A download signed by anything else is never
+ * installed, whichever server served it.
+ */
+final class Catalog {
+
+    static final String GMS = "com.google.android.gms";
+    static final String PLAY_STORE = "com.android.vending";
+    static final String AURORA = "com.aurora.store";
+    static final String FDROID = "org.fdroid.fdroid";
+    static final String TITANIUM = "io.github.jqssun.helium";
+
+    // Google's app signing key, and GmsCore's rotated key (GmsCore is signed by the
+    // second with the first in its rotation lineage).
+    private static final String GOOGLE = "7ce83c1b71f3d572fed04c8d40c5cb10ff75e6d87d9df6fbd53f0468c2905053";
+    private static final String GOOGLE_GMS_ROTATED = "5f2391277b1dbd489000467e4c2fa6af802430080457dce2f618992e9dfb5402";
+
+    static final class App {
+        final String pkg;
+        final String label;
+        final Source source;
+        final Set<String> certs;
+        /** Must be installed (by us or otherwise) before this one is attempted. */
+        final String requires;
+
+        App(String pkg, String label, Source source, Set<String> certs, String requires) {
+            this.pkg = pkg;
+            this.label = label;
+            this.source = source;
+            this.certs = certs;
+            this.requires = requires;
+        }
+    }
+
+    /** Install order matters: GmsCore before the Play Store. */
+    static List<App> apps() {
+        return List.of(
+                new App(GMS, "Google Play services (sandboxed)",
+                        new GrapheneRepoSource(GMS), Set.of(GOOGLE, GOOGLE_GMS_ROTATED), null),
+                new App(PLAY_STORE, "Google Play Store (sandboxed)",
+                        new GrapheneRepoSource(PLAY_STORE), Set.of(GOOGLE), GMS),
+                new App(AURORA, "Aurora Store",
+                        new AuroraFeedSource(),
+                        Set.of("4c626157ad02bda3401a7263555f68a79663fc3e13a4d4369a12570941aa280f"), null),
+                new App(FDROID, "F-Droid",
+                        new FDroidSource(),
+                        Set.of("43238d512c1e5eb2d6569f4a3afbf5523418b82e0a3ed1552770abb9a9c9ccab"), null),
+                new App(TITANIUM, "Titanium Browser",
+                        new GitHubReleaseSource(TITANIUM, "jqssun/android-titanium-browser"),
+                        Set.of("095540494d53f48ca051bc86c392c46edb29725da5592bd8af3c3d027b3166bb"), null));
+    }
+
+    private Catalog() {}
+}
diff --git a/apps/AppSetup/src/app/cancunf/appsetup/Engine.java b/apps/AppSetup/src/app/cancunf/appsetup/Engine.java
new file mode 100644
index 0000000..00542cd
--- /dev/null
+++ b/apps/AppSetup/src/app/cancunf/appsetup/Engine.java
@@ -0,0 +1,134 @@
+package app.cancunf.appsetup;
+
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.util.Log;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+
+/**
+ * Resolves, downloads, verifies and installs. One app's failure never stops
+ * the others; nothing is installed unless it passed Verifier and is newer than
+ * what is installed (no downgrades, whatever a source says).
+ */
+final class Engine {
+
+    private static final String TAG = "AppSetup";
+    // Ceiling for one APK when the source states no size (F-Droid).
+    private static final long DEFAULT_MAX_APK = 512L * 1024 * 1024;
+
+    interface Listener {
+        void onStatus(String pkg, String status);
+    }
+
+    enum Mode {
+        /** Install the given apps if missing, update them if installed. */
+        INSTALL,
+        /** Update installed apps only; never install a missing one. */
+        UPDATE_ONLY,
+    }
+
+    static void run(Context ctx, Collection<Catalog.App> apps, Mode mode, Listener l) {
+        PackageManager pm = ctx.getPackageManager();
+        RunState state = new RunState(ctx);
+        for (Catalog.App app : apps) {
+            try {
+                String result = runOne(ctx, pm, state, app, mode, l);
+                report(l, app.pkg, result);
+            } catch (IOException | RuntimeException e) {
+                Log.w(TAG, app.pkg + ": " + e.getMessage(), e);
+                report(l, app.pkg, "Failed: " + e.getMessage());
+            }
+        }
+    }
+
+    private static String runOne(Context ctx, PackageManager pm, RunState state, Catalog.App app, Mode mode,
+            Listener l) throws IOException {
+        PackageInfo installed = Util.installed(pm, app.pkg);
+        if (installed == null && mode == Mode.UPDATE_ONLY) {
+            return "Not installed";
+        }
+        if (app.requires != null && Util.installed(pm, app.requires) == null) {
+            return "Skipped: needs " + app.requires + " first";
+        }
+
+        report(l, app.pkg, "Checking…");
+        Release r = app.source.latest(ctx, state);
+        if (r == null) {
+            return "No release for this device";
+        }
+        if (installed != null && upToDate(installed, r)) {
+            return "Up to date (" + installed.versionName + ")";
+        }
+
+        File dir = new File(ctx.getCacheDir(), app.pkg);
+        deleteTree(dir);
+        if (!dir.mkdirs()) {
+            throw new IOException("cannot create " + dir);
+        }
+        try {
+            List<File> files = new ArrayList<>();
+            for (int i = 0; i < r.parts.size(); i++) {
+                Release.Part p = r.parts.get(i);
+                File f = new File(dir, i == 0 ? "base.apk" : p.name);
+                long max = p.size > 0 ? p.size : DEFAULT_MAX_APK;
+                String label = r.parts.size() > 1 ? " (" + (i + 1) + "/" + r.parts.size() + ")" : "";
+                long[] lastPercent = {-1};
+                Http.download(p.url, f, max, p.size, p.sha256, (done, total) -> {
+                    long percent = total > 0 ? done * 100 / total : -1;
+                    if (percent >= 0 && percent != lastPercent[0]) {
+                        lastPercent[0] = percent;
+                        report(l, app.pkg, "Downloading " + r.versionName + label + ": " + percent + "%");
+                    }
+                });
+                files.add(f);
+            }
+
+            long vc = Verifier.check(pm, files.get(0), app.pkg, app.certs, r.versionCode);
+            if (installed != null && installed.getLongVersionCode() >= vc) {
+                return "Up to date (" + installed.versionName + ")";
+            }
+
+            report(l, app.pkg, "Installing " + r.versionName + "…");
+            Installer.install(ctx, app.pkg, files);
+            Log.i(TAG, app.pkg + ": installed " + r.versionName + " (" + vc + ")");
+            return "Installed " + r.versionName;
+        } finally {
+            deleteTree(dir);
+        }
+    }
+
+    /** True when the installed version is at least the release's. */
+    private static boolean upToDate(PackageInfo installed, Release r) {
+        if (r.versionCode != Release.UNKNOWN) {
+            return installed.getLongVersionCode() >= r.versionCode;
+        }
+        // Only a version name is known before downloading (GitHub). Equal names
+        // skip the download; anything else is downloaded and the version code
+        // compared after verification.
+        return r.versionName.equals(installed.versionName);
+    }
+
+    private static void report(Listener l, String pkg, String status) {
+        if (l != null) {
+            l.onStatus(pkg, status);
+        }
+    }
+
+    private static void deleteTree(File f) {
+        File[] children = f.listFiles();
+        if (children != null) {
+            for (File c : children) {
+                deleteTree(c);
+            }
+        }
+        f.delete();
+    }
+
+    private Engine() {}
+}
diff --git a/apps/AppSetup/src/app/cancunf/appsetup/FDroidSource.java b/apps/AppSetup/src/app/cancunf/appsetup/FDroidSource.java
new file mode 100644
index 0000000..e1b17f0
--- /dev/null
+++ b/apps/AppSetup/src/app/cancunf/appsetup/FDroidSource.java
@@ -0,0 +1,40 @@
+package app.cancunf.appsetup;
+
+import android.content.Context;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+
+/** The F-Droid client from f-droid.org's own repository. */
+final class FDroidSource implements Source {
+
+    private static final String API_URL = "https://f-droid.org/api/v1/packages/" + Catalog.FDROID;
+    private static final String REPO_URL = "https://f-droid.org/repo/";
+
+    @Override
+    public Release latest(Context ctx, RunState run) throws IOException {
+        byte[] body = Http.get(API_URL, Http.METADATA_MAX, "application/json");
+        try {
+            JSONObject o = new JSONObject(new String(body, StandardCharsets.UTF_8));
+            long vc = o.getLong("suggestedVersionCode");
+            String name = String.valueOf(vc);
+            JSONArray versions = o.optJSONArray("packages");
+            for (int i = 0; versions != null && i < versions.length(); i++) {
+                JSONObject v = versions.getJSONObject(i);
+                if (v.getLong("versionCode") == vc) {
+                    name = v.getString("versionName");
+                }
+            }
+            String file = Catalog.FDROID + "_" + vc + ".apk";
+            return new Release(Catalog.FDROID, vc, name,
+                    List.of(new Release.Part("base.apk", REPO_URL + file, null, Release.UNKNOWN)));
+        } catch (JSONException e) {
+            throw new IOException("malformed F-Droid API response", e);
+        }
+    }
+}
diff --git a/apps/AppSetup/src/app/cancunf/appsetup/GitHubReleaseSource.java b/apps/AppSetup/src/app/cancunf/appsetup/GitHubReleaseSource.java
new file mode 100644
index 0000000..95a7a19
--- /dev/null
+++ b/apps/AppSetup/src/app/cancunf/appsetup/GitHubReleaseSource.java
@@ -0,0 +1,56 @@
+package app.cancunf.appsetup;
+
+import android.content.Context;
+import android.os.Build;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+
+/**
+ * The newest GitHub release of a repository, choosing the asset built for this
+ * device's ABI ("...-arm64-v8a.apk"). GitHub reports each asset's SHA-256.
+ */
+final class GitHubReleaseSource implements Source {
+
+    private static final String API = "https://api.github.com/repos/";
+    private static final String DIGEST_PREFIX = "sha256:";
+
+    private final String pkg;
+    private final String repo;
+
+    GitHubReleaseSource(String pkg, String repo) {
+        this.pkg = pkg;
+        this.repo = repo;
+    }
+
+    @Override
+    public Release latest(Context ctx, RunState run) throws IOException {
+        byte[] body = Http.get(API + repo + "/releases/latest", Http.METADATA_MAX, "application/vnd.github+json");
+        try {
+            JSONObject r = new JSONObject(new String(body, StandardCharsets.UTF_8));
+            String tag = r.getString("tag_name");
+            String version = tag.startsWith("v") ? tag.substring(1) : tag;
+            String suffix = "-" + Build.SUPPORTED_ABIS[0] + ".apk";
+            JSONArray assets = r.getJSONArray("assets");
+            for (int i = 0; i < assets.length(); i++) {
+                JSONObject a = assets.getJSONObject(i);
+                if (!a.getString("name").endsWith(suffix)) {
+                    continue;
+                }
+                String digest = a.optString("digest", "");
+                String sha = digest.startsWith(DIGEST_PREFIX) ? digest.substring(DIGEST_PREFIX.length()) : null;
+                return new Release(pkg, Release.UNKNOWN, version,
+                        List.of(new Release.Part("base.apk", a.getString("browser_download_url"),
+                                sha, a.getLong("size"))));
+            }
+            return null;
+        } catch (JSONException e) {
+            throw new IOException("malformed GitHub release for " + repo, e);
+        }
+    }
+}
