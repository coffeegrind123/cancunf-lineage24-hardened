From 1c2660bc5d290c93f1351e30cac26c276458fc2d Mon Sep 17 00:00:00 2001
From: lineage-build <build@localhost>
Date: Tue, 10 Nov 2026 22:59:29 +0000
Subject: [PATCH] cancunf: Port the touch HAL to AIDL

LineageOS 24 dropped the HIDL vendor.lineage.touch@1.0 interface. Serve
the same single-tap gesture over vendor.lineage.touch-V1, following
motorola/sm8475-common, and update the service label.
---
 device.mk                                     |  2 +-
 sepolicy/vendor/file_contexts                 |  2 +-
 touch/Android.bp                              | 25 +++-------
 touch/TouchscreenGesture.cpp                  | 47 +++++++------------
 touch/TouchscreenGesture.h                    | 45 ++++--------------
 touch/service.cpp                             | 45 ++++++------------
 ...> vendor.lineage.touch-service.cancunf.rc} |  3 +-
 .../vendor.lineage.touch-service.cancunf.xml  |  7 +++
 ...ndor.lineage.touch@1.0-service.cancunf.xml | 11 -----
 9 files changed, 57 insertions(+), 130 deletions(-)
 rename touch/{vendor.lineage.touch@1.0-service.cancunf.rc => vendor.lineage.touch-service.cancunf.rc} (58%)
 create mode 100644 touch/vendor.lineage.touch-service.cancunf.xml
 delete mode 100644 touch/vendor.lineage.touch@1.0-service.cancunf.xml

diff --git a/device.mk b/device.mk
index fc13851..0a09a4b 100644
--- a/device.mk
+++ b/device.mk
@@ -419,7 +419,7 @@ PRODUCT_COPY_FILES += \
 
 # Touch
 PRODUCT_PACKAGES += \
-    vendor.lineage.touch@1.0-service.cancunf
+    vendor.lineage.touch-service.cancunf
 
 # USB
 $(call soong_config_set_bool,android_hardware_mediatek_usb,audio_accessory_supported,true)
diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
index 7d7641f..5dad5ee 100644
--- a/sepolicy/vendor/file_contexts
+++ b/sepolicy/vendor/file_contexts
@@ -49,7 +49,7 @@
 /vendor/bin/hw/android\.hardware\.power-service\.pixel-libperfmgr                      u:object_r:hal_power_default_exec:s0
 
 # Touch
-/vendor/bin/hw/vendor\.lineage\.touch@1\.0-service\.cancunf                                 u:object_r:hal_lineage_touch_default_exec:s0
+/vendor/bin/hw/vendor\.lineage\.touch-service\.cancunf                                       u:object_r:hal_lineage_touch_default_exec:s0
 
 # Wakeups
 /sys/devices/platform/soc/[^*]+/wakeup/wakeup[0-9]+(/.*)?                              u:object_r:sysfs_wakeup:s0
diff --git a/touch/Android.bp b/touch/Android.bp
index 5ae079f..7caf68d 100644
--- a/touch/Android.bp
+++ b/touch/Android.bp
@@ -1,23 +1,12 @@
