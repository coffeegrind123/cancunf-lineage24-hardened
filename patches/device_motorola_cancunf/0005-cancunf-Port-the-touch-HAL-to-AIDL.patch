 cc_binary {
-    name: "vendor.lineage.touch@1.0-service.cancunf",
-    defaults: ["hidl_defaults"],
-    vintf_fragments: ["vendor.lineage.touch@1.0-service.cancunf.xml"],
-    init_rc: ["vendor.lineage.touch@1.0-service.cancunf.rc"],
+    name: "vendor.lineage.touch-service.cancunf",
+    vintf_fragments: ["vendor.lineage.touch-service.cancunf.xml"],
+    init_rc: ["vendor.lineage.touch-service.cancunf.rc"],
     relative_install_path: "hw",
     proprietary: true,
     srcs: [
@@ -26,9 +15,9 @@ cc_binary {
     ],
     shared_libs: [
         "libbase",
-        "libbinder",
-        "libhidlbase",
+        "libbinder_ndk",
+        "liblog",
         "libutils",
-        "vendor.lineage.touch@1.0",
+        "vendor.lineage.touch-V1-ndk",
     ],
 }
